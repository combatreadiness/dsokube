#!/usr/bin/env bash
# =============================================================
# dsokube — K3s or RKE2 on machines you already have, through the official Ansible playbooks
#   K3s : k3s-ansible   groups k3s_cluster, server, agent
#   RKE2: rke2-ansible  groups rke2_cluster, rke2_servers, rke2_agents
#   The groups in the inventory decide which one a cluster gets.
#   Inventory: a dsonode set name, or any Ansible inventory file (-i).
#
# Needs  : bash, curl, jq, git, ansible-core 2.15+
# Usage  : dsokube help
#
# One folder per cluster: ~/.config/dsokube/<cluster>/
#   token        K3s join token, made once (600). RKE2 keeps its own on the first server.
#   kubeconfig   context named after the cluster
#   vars.yml     optional, yours: extra playbook variables, passed on every up
# Shared:  ~/.config/dsokube/collections   the pinned k3s-ansible
#          ~/.config/dsokube/vendor        the pinned rke2-ansible
# =============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/common.sh
. "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/checks.sh
. "${SCRIPT_DIR}/lib/checks.sh"

DSOKUBE_HOME="${DSOKUBE_HOME:-$HOME/.config/dsokube}"
export ANSIBLE_PYTHON_INTERPRETER="${ANSIBLE_PYTHON_INTERPRETER:-auto_silent}"
NAME_RE='^[a-z][a-z0-9-]{0,15}$'

usage() {
  cat <<'EOF'
Usage: dsokube <command> <cluster> [options]

  up <cluster> [-i INVENTORY]   install or update K3s or RKE2 (runs again safely)
  status <cluster>              nodes and pods
  ctx <cluster>                 point ~/.kube/config at this cluster
  down <cluster> [-y]           uninstall Kubernetes from the nodes (machines stay)
  help

<cluster> is a dsonode set name: its inventory comes from `dsonode inventory <cluster>`.
With -i, any inventory file works; <cluster> then only names the folder and context.

The inventory's groups pick the distribution:
  K3s   k3s_cluster, server, agent
  RKE2  rke2_cluster, rke2_servers, rke2_agents

~/.config/dsokube/<cluster>/vars.yml, when it exists, goes to the playbook on every up
(K3s: server_config_yaml, extra_server_args, ...  RKE2: cluster_rke2_config, ...).
EOF
}

# resolve <cluster> [-i inventory]  -> NAME, DIR, INV
resolve() {
  NAME="${1:-}"; shift || true
  if [[ -z "$NAME" ]]; then
    info "Clusters: $(find "$DSOKUBE_HOME" -mindepth 1 -maxdepth 1 -type d ! -name collections ! -name vendor -printf "%f " 2>/dev/null)"
    die "Usage: dsokube <command> <cluster> [-i INVENTORY] [-y]"
  fi
  [[ "$NAME" =~ $NAME_RE ]] || die "Cluster name: lowercase letters, digits and -, starting with a letter."
  INV=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i) INV="${2:-}"; shift 2 ;;
      -y) YES=1; shift ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  if [[ -z "$INV" ]]; then
    command -v dsonode >/dev/null || die "No -i INVENTORY, and dsonode is not installed."
    INV="$(dsonode inventory "$NAME")" || die "dsonode has no built set '${NAME}'. Run: dsonode up ${NAME}"
  fi
  [[ -f "$INV" ]] || die "No inventory file ${INV}"
  DIR="${DSOKUBE_HOME}/${NAME}"
  install -d -m 700 "$DIR"
}

# extra_vars  -> EXTRA: -e @vars.yml when the cluster has one. It goes first, so dsokube's own -e still win.
extra_vars() {
  EXTRA=()
  if [[ -f "${DIR}/vars.yml" ]]; then
    EXTRA=(-e "@${DIR}/vars.yml")
    log "Extra variables: ${DIR}/vars.yml"
  fi
}

# fetch_kubeconfig <path on the first server>  -> ${DIR}/kubeconfig, replacing what was there
fetch_kubeconfig() {
  ansible -i "$INV" "${SERVER_GROUP}[0]" -b -m ansible.builtin.fetch \
    -a "src=$1 dest=${DIR}/kubeconfig flat=yes" >/dev/null \
    || die "Could not fetch the kubeconfig from the first server."
}

# fix_kubeconfig  -> point it at the first server; name the cluster, user and context after this cluster
fix_kubeconfig() {
  chmod 600 "${DIR}/kubeconfig"
  sed -i -E \
    -e "s#https://127\.0\.0\.1:6443#https://${API_ENDPOINT}:6443#" \
    -e "s/^(\s*(- )?(name|cluster|user|current-context): )default$/\1${NAME}/" \
    "${DIR}/kubeconfig"
}

up_k3s() {
  need_collection
  if [[ ! -s "${DIR}/token" ]]; then
    ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "${DIR}/token" )
    log "Join token created: ${DIR}/token"
  fi
  extra_vars

  step "K3s ${K3S_VERSION} on ${NAME} (k3s-ansible ${K3S_ANSIBLE_VERSION})"
  ansible-playbook -i "$INV" k3s.orchestration.site \
    ${EXTRA[@]+"${EXTRA[@]}"} \
    -e "k3s_version=${K3S_VERSION}" \
    -e "token=$(cat "${DIR}/token")" \
    -e "api_endpoint=${API_ENDPOINT}" \
    -e "kubeconfig=${DIR}/kubeconfig"

  # k3s-ansible copies the kubeconfig back only when the server's copy changed.
  # On a re-run (or after a manual run) it may not: fetch it ourselves.
  [[ -s "${DIR}/kubeconfig" ]] || fetch_kubeconfig /etc/rancher/k3s/k3s.yaml
  fix_kubeconfig
}

up_rke2() {
  check_rke2_cni "${DIR}/vars.yml"
  need_rke2_ansible
  extra_vars

  step "RKE2 ${RKE2_VERSION} on ${NAME} (rke2-ansible ${RKE2_ANSIBLE_VERSION})"
  # The playbook runs on hosts: all and treats every non-server as an agent: keep it to the cluster.
  # Its roles path lives in the repository's ansible.cfg, which only counts when run from there.
  # Give the path alone: that ansible.cfg also turns host key checking off.
  ANSIBLE_ROLES_PATH="${RKE2_ANSIBLE_DIR}/roles" \
  ansible-playbook -i "$INV" "${RKE2_ANSIBLE_DIR}/playbooks/install.yml" -b \
    --limit "${SERVER_GROUP}:${AGENT_GROUP}" \
    ${EXTRA[@]+"${EXTRA[@]}"} \
    -e "rke2_install_version=${RKE2_VERSION}"

  # A reinstall makes a new CA, so an old kubeconfig stops working: always take the server's.
  fetch_kubeconfig /etc/rancher/rke2/rke2.yaml
  fix_kubeconfig

  # The playbook waits for the first server only; agents turn Ready about a minute later.
  step "Waiting for ${NODE_COUNT} node(s) to be Ready"
  local i have=0
  for ((i = 0; i < 60; i++)); do
    have="$(KUBECONFIG="${DIR}/kubeconfig" kubectl get nodes --no-headers 2>/dev/null | wc -l)"
    [[ "$have" -ge "$NODE_COUNT" ]] && break
    sleep 5
  done
  if [[ "$have" -ge "$NODE_COUNT" ]] \
     && KUBECONFIG="${DIR}/kubeconfig" kubectl wait --for=condition=Ready node --all --timeout=300s >/dev/null 2>&1; then
    log "All ${NODE_COUNT} node(s) Ready"
  else
    warn "Not every node is Ready yet (${have}/${NODE_COUNT} registered). Look again with: dsokube status ${NAME}"
  fi
}

cmd_up() {
  YES=0
  resolve "$@"
  load_versions
  step "Checks"
  need_ansible
  check_inventory "$INV"
  need_kubectl

  case "$DISTRO" in
    k3s)  up_k3s ;;
    rke2) up_rke2 ;;
  esac

  echo
  log "Cluster '${NAME}' (${DISTRO_LABEL}) is up. kubeconfig: ${DIR}/kubeconfig"
  KUBECONFIG="${DIR}/kubeconfig" kubectl get nodes -o wide
  info "Next: dsokube ctx ${NAME}   (then plain kubectl works)"
}

cmd_status() {
  resolve "$@"
  [[ -f "${DIR}/kubeconfig" ]] || die "No kubeconfig yet. Run: dsokube up ${NAME}"
  KUBECONFIG="${DIR}/kubeconfig" kubectl get nodes -o wide
  echo
  KUBECONFIG="${DIR}/kubeconfig" kubectl get pods -A
}

cmd_ctx() {
  resolve "$@"
  [[ -f "${DIR}/kubeconfig" ]] || die "No kubeconfig yet. Run: dsokube up ${NAME}"
  install -d -m 700 "$HOME/.kube"
  if [[ -f "$HOME/.kube/config" && ! -L "$HOME/.kube/config" ]]; then
    mv "$HOME/.kube/config" "$HOME/.kube/config.bak.$(date +%Y%m%d%H%M%S)"
    warn "Moved your own ~/.kube/config aside (config.bak.*)"
  fi
  ln -sfn "${DIR}/kubeconfig" "$HOME/.kube/config"
  log "Linked ~/.kube/config -> ${NAME}"
  kubectl get nodes
}

# rke2-ansible has no reset playbook. RKE2 installs its own uninstall script on every node:
# /usr/local/bin for the tarball install (Debian, Ubuntu), /usr/bin for the RPM one.
RKE2_UNINSTALL='for f in /usr/local/bin/rke2-uninstall.sh /usr/bin/rke2-uninstall.sh; do
  if [ -x "$f" ]; then "$f" >/var/log/rke2-uninstall.log 2>&1 && echo removed; exit $?; fi
done; echo "not installed"'

cmd_down() {
  YES=0
  resolve "$@"
  load_versions
  need_ansible
  check_inventory "$INV"
  if [[ "$YES" -ne 1 ]]; then
    read -rp "  Uninstall ${DISTRO_LABEL} from every node of '${NAME}'? Cluster data is lost. [y/N] " a
    [[ "$a" == "y" || "$a" == "Y" ]] || { info "Nothing changed."; return 0; }
  fi
  case "$DISTRO" in
    k3s)
      need_collection
      ansible-playbook -i "$INV" k3s.orchestration.reset
      ;;
    rke2)
      # Agents first, so none of them keeps trying to reach a server that is already gone
      local g out rc
      for g in "$AGENT_GROUP" "$SERVER_GROUP"; do
        step "Uninstalling RKE2: ${g}"
        rc=0
        out="$(ansible -i "$INV" "$g" -b -m ansible.builtin.shell -a "$RKE2_UNINSTALL" -o 2>&1)" || rc=$?
        # An empty agent group is fine: drop Ansible's "no hosts" warnings
        grep -vE 'No hosts matched|Could not match supplied host pattern' <<<"$out" || true
        [[ "$rc" -eq 0 ]] || die "Uninstall failed on ${g}. Log on each node: /var/log/rke2-uninstall.log"
      done
      ;;
  esac
  if [[ -L "$HOME/.kube/config" && "$(readlink "$HOME/.kube/config")" == "${DIR}/kubeconfig" ]]; then
    rm -f "$HOME/.kube/config"
  fi
  rm -f "${DIR}/kubeconfig" "${DIR}/token"
  log "${DISTRO_LABEL} removed from '${NAME}'. The machines are still there (dsonode down ${NAME} removes them)."
}

main() {
  local cmd="${1:-help}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$cmd" in
    up)     cmd_up "$@" ;;
    status) cmd_status "$@" ;;
    ctx)    cmd_ctx "$@" ;;
    down)   cmd_down "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
